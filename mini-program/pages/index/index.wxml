<view class="app theme-{{theme}}">

  <!-- 页头 -->
  <view class="hd">
    <view>
      <view class="hd-title">智能门锁</view>
      <view class="hd-sub">{{mode === 'cloud' ? '巴法云 · ' + (topic || '未设置主题') : (bleName || '蓝牙直连')}}</view>
    </view>
    <view class="hd-btn" bindtap="onToggleTheme">
      <view class="icon icon-md {{theme === 'dark' ? 'i-sun' : 'i-moon'}}"></view>
    </view>
  </view>

  <!-- 通道切换 -->
  <view class="seg">
    <view class="seg-item {{mode === 'cloud' ? 'active' : ''}}" data-mode="cloud" bindtap="onMode">
      <view class="icon icon-sm i-cloud"></view>
      <text>云端 MQTT</text>
    </view>
    <view class="seg-item {{mode === 'ble' ? 'active' : ''}}" data-mode="ble" bindtap="onMode">
      <view class="icon icon-sm i-bt"></view>
      <text>蓝牙直连</text>
    </view>
  </view>

  <!-- 状态主卡 -->
  <view class="hero">
    <view class="hero-top">
      <view class="hero-pill">
        <view class="hero-dot {{online ? 'on' : (connected ? 'warn' : '')}}"></view>
        <text>{{online ? '在线' : (connected ? '连接中' : '离线')}}</text>
      </view>
      <view class="hero-pill">{{mode === 'cloud' ? '远程通道' : '近场通道'}}</view>
    </view>

    <view class="hero-ring {{lockState === 'unlock' ? 'open' : ''}}">
      <view class="icon icon-xl {{lockState === 'unlock' ? 'i-unlock' : 'i-lock'}}"></view>
    </view>

    <view class="hero-state">
      {{lockState === 'unlock' ? '已开锁' : (lockState === 'lock' ? '已上锁' : '状态未知')}}
      <text class="sub">{{lockState === 'unlock' ? '门锁已打开 · 2 秒后自动回锁' : (lockState === 'lock' ? '门锁已关闭' : '点下方「查询」获取当前状态')}}</text>
    </view>
  </view>

  <!-- 操作 -->
  <button class="btn primary big" bindtap="onUnlock">
    <view class="icon icon-md i-unlock"></view>
    <text>开 锁</text>
  </button>

  <view class="btn-row" style="margin-top:18rpx">
    <button class="btn plain" bindtap="onLock">
      <view class="icon icon-sm i-lock"></view>
      <text>上锁</text>
    </button>
    <button class="btn plain" bindtap="onRefresh">
      <view class="icon icon-sm i-refresh"></view>
      <text>查询</text>
    </button>
    <button class="btn plain" bindtap="onReconnect">
      <view class="icon icon-sm i-wifi"></view>
      <text>重连</text>
    </button>
  </view>

  <!-- 蓝牙设备列表 -->
  <block wx:if="{{mode === 'ble'}}">
    <view class="card" style="margin-top:22rpx">
      <view class="card-hd">
        <view class="ico-box"><view class="icon icon-md i-bt"></view></view>
        <view>
          <view class="card-t">附近的 BLE 设备</view>
          <view class="card-d">{{scanning ? '正在扫描，12 秒后自动停止…' : (devices.length ? '共 ' + devices.length + ' 个，可重新扫描' : '点右侧按钮搜索模块')}}</view>
        </view>
        <view class="card-hd-r" bindtap="onScan">
          <view class="tag {{scanning ? 'warn' : ''}}">{{scanning ? '停止' : '扫描'}}</view>
        </view>
      </view>

      <view wx:if="{{scanStat.filter}}" class="hint box warn">
        <view class="icon icon-sm i-shield"></view>
        <view class="hint-text">设置页填了设备名过滤「{{scanStat.filter}}」。列表仍显示全部设备，命中过滤的会标「匹配」。</view>
      </view>

      <view wx:if="{{bleServiceHint}}" class="hint box">
        <view class="icon icon-sm i-shield" style="color:var(--ok)"></view>
        <view class="hint-text">已识别特征值 {{bleServiceHint}}</view>
      </view>

      <view wx:if="{{devices.length === 0}}" class="empty">{{scanning ? '搜索中，请稍候…' : '还没有搜到设备'}}</view>

      <view wx:for="{{devices}}" wx:key="deviceId" class="dev-item">
        <view>
          <view class="dev-name">
            {{item.name || '(无名设备)'}}
            <text wx:if="{{scanStat.filter && item.matched}}" class="tag ok">匹配</text>
          </view>
          <view class="dev-meta">{{item.rssi}} dBm · {{item.deviceId}}</view>
        </view>
        <view class="dev-connect" data-id="{{item.deviceId}}" bindtap="onPickDevice">连接</view>
      </view>

      <view class="section-gap"></view>
      <view class="card-hd" bindtap="onScanHelp">
        <view class="ico-box"><view class="icon icon-sm i-terminal"></view></view>
        <view class="card-d">扫描不到设备？点这里做一次蓝牙自检</view>
      </view>
    </view>
  </block>

  <!-- 日志 -->
  <view class="card" style="margin-top:22rpx">
    <view class="card-hd">
      <view class="ico-box"><view class="icon icon-md i-terminal"></view></view>
      <view>
        <view class="card-t">收发日志</view>
        <view class="card-d">最新在上，最多保留 40 条</view>
      </view>
      <view class="card-hd-r" bindtap="onClearLog">
        <view class="tag"><view class="icon icon-sm i-x"></view>清空</view>
      </view>
    </view>

    <view class="log-box">
      <view wx:if="{{logs.length === 0}}" class="empty">暂无记录</view>
      <view wx:for="{{logs}}" wx:key="index" class="log-line {{item.cls}}">
        <text class="log-time">{{item.time}}</text>
        <text>{{item.text}}</text>
      </view>
    </view>
  </view>

</view>
