<view class="page">

  <!-- 通道切换 -->
  <view class="mode-bar">
    <view class="mode-item {{mode === 'cloud' ? 'active' : ''}}" data-mode="cloud" bindtap="onMode">云端 MQTT</view>
    <view class="mode-item {{mode === 'ble' ? 'active' : ''}}" data-mode="ble" bindtap="onMode">蓝牙直连</view>
  </view>

  <!-- 连接状态 -->
  <view class="card">
    <view class="conn-row">
      <view class="dot {{online ? 'on' : (connected ? 'warn' : '')}}"></view>
      <text class="conn-text">{{online ? '已连接，可以下发命令' : (connected ? '连接中…' : '未连接')}}</text>
    </view>
    <view class="conn-sub">{{mode === 'cloud' ? '巴法云 MQTT（任意网络可用，真·远程）' : 'BLE 直连（需在门锁附近，约 10 米）'}}</view>
    <view wx:if="{{bleServiceHint}}" class="conn-sub">特征值：{{bleServiceHint}}</view>
  </view>

  <!-- 门锁状态 -->
  <view class="card lock-card">
    <view class="lock-badge {{lockState === 'unlock' ? 'unlock' : ''}}">
      {{lockState === 'unlock' ? '已开锁' : (lockState === 'lock' ? '已上锁' : '状态未知')}}
    </view>
    <view class="lock-name {{lockState === 'unlock' ? 'unlock' : ''}}">
      {{lockState === 'unlock' ? '门锁已打开' : (lockState === 'lock' ? '门锁已关闭' : '点下方按钮查询')}}
    </view>
    <view class="lock-tip">开锁后设备会在 2 秒后自动回锁</view>
  </view>

  <!-- 操作按钮 -->
  <view class="btn-row">
    <button class="btn primary" bindtap="onUnlock">开 锁</button>
    <button class="btn ghost" bindtap="onLock">上 锁</button>
  </view>
  <view class="btn-row">
    <button class="btn plain" bindtap="onRefresh">查询状态</button>
    <button class="btn plain" bindtap="onReconnect">重 连</button>
  </view>

  <!-- 蓝牙设备列表 -->
  <block wx:if="{{mode === 'ble'}}">
    <view class="card">
      <view class="card-title">附近的 BLE 设备</view>
      <view class="btn-row">
        <button class="btn plain" bindtap="onScan">{{scanning ? '停止扫描' : '扫描设备'}}</button>
      </view>
      <view wx:if="{{devices.length === 0}}" class="empty">还没扫到设备，点上面的按钮开始扫描</view>
      <view wx:for="{{devices}}" wx:key="deviceId" class="dev-item">
        <view>
          <view class="dev-name">{{item.name || '(无名设备)'}}</view>
          <view class="dev-meta">{{item.deviceId}} · RSSI {{item.rssi}}</view>
        </view>
        <view class="dev-connect" data-id="{{item.deviceId}}" bindtap="onPickDevice">连接</view>
      </view>
    </view>
  </block>

  <!-- 日志 -->
  <view class="card">
    <view class="card-title" bindtap="onClearLog">收发日志（点击清空，最新在上）</view>
    <view class="log-box">
      <view wx:if="{{logs.length === 0}}" class="empty">暂无记录</view>
      <view wx:for="{{logs}}" wx:key="index" class="log-line {{item.cls}}">{{item.time}}  {{item.text}}</view>
    </view>
  </view>

</view>
