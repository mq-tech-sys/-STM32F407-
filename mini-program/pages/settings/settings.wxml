<view class="app theme-{{theme}}">

  <!-- 页头 -->
  <view class="hd">
    <view>
      <view class="hd-title">设置</view>
      <view class="hd-sub">配置保存在本机，改完点底部「保存」</view>
    </view>
  </view>

  <!-- 外观 -->
  <view class="card">
    <view class="card-hd">
      <view class="ico-box"><view class="icon icon-md {{theme === 'dark' ? 'i-moon' : 'i-sun'}}"></view></view>
      <view>
        <view class="card-t">外观</view>
        <view class="card-d">切换后立即生效，下次打开保持</view>
      </view>
    </view>

    <view class="theme-row">
      <view class="theme-tile {{theme === 'light' ? 'on' : ''}}" data-t="light" bindtap="onPickTheme">
        <view class="icon icon-md i-sun"></view>
        <view class="t">浅色</view>
      </view>
      <view class="theme-tile {{theme === 'dark' ? 'on' : ''}}" data-t="dark" bindtap="onPickTheme">
        <view class="icon icon-md i-moon"></view>
        <view class="t">深色</view>
      </view>
    </view>
  </view>

  <!-- 巴法云 -->
  <view class="group-head">巴法云 MQTT · 云端模式</view>
  <view class="card">
    <view class="card-hd">
      <view class="ico-box"><view class="icon icon-md i-cloud"></view></view>
      <view>
        <view class="card-t">连接参数</view>
        <view class="card-d">小程序只能连加密 WebSocket</view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">服务器</text>
      <input class="field-input" data-key="url" value="{{url}}" bindinput="onInput"
             placeholder="wss://bemfa.com:9504/wss" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="field-label">主题名</text>
      <input class="field-input" data-key="topic" value="{{topic}}" bindinput="onInput"
             placeholder="与固件一致，如 lock000" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="field-label">ClientID</text>
      <input class="field-input" data-key="clientId" value="{{clientId}}" bindinput="onInput"
             placeholder="独立 ID，别填私钥" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="field-label">用户名</text>
      <input class="field-input" data-key="username" value="{{username}}" bindinput="onInput"
             placeholder="必填：appID" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input class="field-input" data-key="password" value="{{password}}" bindinput="onInput"
             placeholder="必填：secretKey" placeholder-class="ph" password="{{true}}" />
    </view>
    <view class="field">
      <text class="field-label">KeepAlive</text>
      <input class="field-input" type="number" data-key="keepalive" value="{{keepalive}}" bindinput="onInput" />
    </view>

    <view class="hint box warn">
      <view class="icon icon-sm i-alert"></view>
      <view class="hint-text">
        <text class="strong">ClientID 不能填巴法云私钥</text>——私钥是设备端在用的，同 ID 后连会把设备顶下线。
      </view>
    </view>

    <view class="hint box">
      <view class="icon icon-sm i-shield"></view>
      <view class="hint-text">
        巴法云规则：ClientID 不等于私钥时，必须用 appID / secretKey 认证。所以用户名填 appID、密码填 secretKey（巴法云「连接密钥」页复制），留空会连不上并返回 4/5。
      </view>
    </view>

    <view class="hint">设备端固件里写死的私钥与主题：{{fwUid}} / {{fwTopic}}（改这里无效，要改固件头文件）</view>

    <view class="section-gap"></view>
    <button class="btn plain" bindtap="onTestCloud">
      <view class="icon icon-sm i-wifi"></view>
      <text>保存并立即试连</text>
    </button>
  </view>

  <!-- 蓝牙 -->
  <view class="group-head">蓝牙 BLE · 直连模式</view>
  <view class="card">
    <view class="card-hd">
      <view class="ico-box ok"><view class="icon icon-md i-bt"></view></view>
      <view>
        <view class="card-t">模块信息</view>
        <view class="card-d">UUID 留空 = 自动识别</view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">设备名过滤</text>
      <input class="field-input" data-key="nameFilter" value="{{nameFilter}}" bindinput="onInput"
             placeholder="留空显示全部，如 JDY" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="field-label">Service UUID</text>
      <input class="field-input" data-key="serviceId" value="{{serviceId}}" bindinput="onInput"
             placeholder="留空 = 自动识别" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="field-label">特征值 UUID</text>
      <input class="field-input" data-key="characteristicId" value="{{characteristicId}}" bindinput="onInput"
             placeholder="留空 = 自动识别" placeholder-class="ph" />
    </view>

    <view class="hint">串口透传模块（JDY-24 / HM-10 / AT-09 之类）常见服务 <text class="strong">0000FFE0</text>、特征值 <text class="strong">0000FFE1</text>，留空也能自动识别。</view>
    <view class="hint box warn">
      <view class="icon icon-sm i-shield"></view>
      <view class="hint-text">必须是 <text class="strong">BLE（低功耗蓝牙）</text>模块。ESP8266 只有 WiFi、<text class="strong">没有蓝牙</text>；HC-05/06、JDY-31 这类经典蓝牙小程序也连不上。</view>
    </view>

    <view class="sub-head">诊断工具</view>
    <view class="tool-panel">
      <view class="tool-item" hover-class="tool-hover" bindtap="onShowUuids">
        <view class="tool-ico"><view class="icon icon-sm i-terminal"></view></view>
        <view class="tool-body">
          <view class="tool-t">列出设备全部 UUID</view>
          <view class="tool-d">读取服务与特征值，点结果直接填入</view>
        </view>
        <view class="icon icon-sm i-chev tool-chev"></view>
      </view>

      <view class="tool-item" hover-class="tool-hover" bindtap="onBleDiag">
        <view class="tool-ico"><view class="icon icon-sm i-bt"></view></view>
        <view class="tool-body">
          <view class="tool-t">蓝牙自检</view>
          <view class="tool-d">扫不到设备时用，逐项查权限与开关</view>
        </view>
        <view class="icon icon-sm i-chev tool-chev"></view>
      </view>
    </view>

    <view wx:if="{{bleDiag.length > 0}}" class="diag-box">
      <view wx:for="{{bleDiag}}" wx:key="index" class="diag-line">{{item}}</view>
    </view>

    <view wx:if="{{uuidList.length > 0}}">
      <view class="sub-head">读到的特征值</view>
      <view wx:for="{{uuidList}}" wx:key="characteristicId" class="dev-item"
            data-index="{{index}}" bindtap="onUseUuid">
        <view class="dev-main">
          <view class="dev-name">{{item.characteristicId}}</view>
          <view class="dev-meta">服务 {{item.serviceId}}</view>
          <view class="dev-meta">属性 {{item.properties}}</view>
        </view>
        <view class="dev-connect">使用</view>
      </view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="save-area">
    <button class="btn save big" bindtap="onSave">
      <view class="icon icon-md i-check"></view>
      <text>保存配置</text>
    </button>
    <view class="save-tip">配置只保存在本机，换手机要重新填一次</view>
    <view class="btn-row">
      <button class="btn sm danger" bindtap="onReset">恢复默认</button>
      <button class="btn sm plain" bindtap="onGotoControl">回到控制页</button>
    </view>
  </view>

  <!-- 说明 -->
  <view class="card" style="margin-top:22rpx">
    <view class="card-hd">
      <view class="ico-box"><view class="icon icon-md i-gear"></view></view>
      <view>
        <view class="card-t">两种模式怎么选</view>
        <view class="card-d">取决于板子上插的是哪个模块</view>
      </view>
    </view>

    <view class="hint"><text class="strong">云端 MQTT</text>：手机在任何网络都能开锁，走巴法云转发。设备端要插 ESP8266（固件 USART3_WIFI_USE = 1）。</view>
    <view class="hint"><text class="strong">蓝牙直连</text>：手机需在门锁约 10 米内，不经云端，断网也能用。设备端要插 BLE 模块（固件 USART3_BLE_USE = 1）。</view>
    <view class="hint">USART3 同一时刻只能接一个模块，两种模式对应两份固件配置，不能同时用。</view>
  </view>

</view>
