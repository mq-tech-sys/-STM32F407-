/* ==========================================================================
   智能门锁 · 全局样式
   - 明暗双主题：所有颜色走 CSS 变量，根节点 class="app theme-light|theme-dark"
   - 图标：SVG data URI + mask，颜色取 currentColor，天然跟随主题/按钮文字色
   ========================================================================== */

page {
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------------- 主题变量 ---------------- */

.app {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
  background: var(--bg);
  color: var(--text);
  transition: background 0.25s, color 0.25s;
}

.theme-light {
  --bg: #f4f6fb;
  --bg-grad: radial-gradient(120% 80% at 50% -10%, #e7efff 0%, #f4f6fb 60%);
  --card: #ffffff;
  --card-2: #f7f9fd;
  --line: #e7ecf5;
  --line-2: #eff2f8;
  --text: #0f172a;
  --text-2: #475467;
  --text-3: #98a2b3;
  --primary: #2563eb;
  --primary-2: #1d4ed8;
  --primary-soft: #e9f0ff;
  --ok: #16a34a;
  --ok-soft: #e7f7ed;
  --warn: #d97706;
  --warn-soft: #fef4e6;
  --danger: #e11d48;
  --danger-soft: #fdecf0;
  --shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.06);
  --shadow-lg: 0 18rpx 46rpx rgba(37, 99, 235, 0.18);
  --hero: linear-gradient(150deg, #2f6bff 0%, #1e4fd8 55%, #163bb0 100%);
  --hero-text: #ffffff;
  --hero-sub: rgba(255, 255, 255, 0.72);
  --hero-glass: rgba(255, 255, 255, 0.16);
  --seg-bg: #e9edf6;
}

.theme-dark {
  --bg: #0b0e14;
  --bg-grad: radial-gradient(120% 80% at 50% -10%, #16203a 0%, #0b0e14 62%);
  --card: #151a24;
  --card-2: #1b2130;
  --line: #252c3a;
  --line-2: #202634;
  --text: #e9edf7;
  --text-2: #a7b0c2;
  --text-3: #6f7a8d;
  --primary: #5b8dff;
  --primary-2: #7aa4ff;
  --primary-soft: #1a2740;
  --ok: #34d399;
  --ok-soft: #123024;
  --warn: #fbbf24;
  --warn-soft: #33260f;
  --danger: #fb7185;
  --danger-soft: #331a22;
  --shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.38);
  --shadow-lg: 0 18rpx 46rpx rgba(0, 0, 0, 0.5);
  --hero: linear-gradient(150deg, #1b2a4d 0%, #16203a 60%, #121826 100%);
  --hero-text: #eaf0ff;
  --hero-sub: rgba(234, 240, 255, 0.6);
  --hero-glass: rgba(255, 255, 255, 0.08);
  --seg-bg: #1b2130;
}

/* ---------------- 图标 ---------------- */

.icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  flex: none;
  vertical-align: -0.15em;
  background-color: currentColor;
  -webkit-mask-position: center;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-size: 100% 100%;
  mask-position: center;
  mask-repeat: no-repeat;
  mask-size: 100% 100%;
}

.icon-sm { width: 30rpx; height: 30rpx; }
.icon-md { width: 44rpx; height: 44rpx; }
.icon-lg { width: 64rpx; height: 64rpx; }
.icon-xl { width: 96rpx; height: 96rpx; }

