/* ---------------- 页头 ---------------- */

.hd {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 12rpx 6rpx 26rpx;
}

.hd-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--text);
}

.hd-sub {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.hd-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-2);
  box-shadow: var(--shadow);
}

/* ---------------- 卡片 ---------------- */

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: var(--shadow);
}

.card-hd {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.ico-box {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  background: var(--primary-soft);
  color: var(--primary);
  flex: none;
}

.ico-box.ok { background: var(--ok-soft); color: var(--ok); }
.ico-box.warn { background: var(--warn-soft); color: var(--warn); }
.ico-box.danger { background: var(--danger-soft); color: var(--danger); }

.card-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.card-d {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  line-height: 1.45;
}

.card-hd-r {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-3);
  display: flex;
  align-items: center;
}

/* ---------------- 分段控件 ---------------- */

.seg {
  display: flex;
  background: var(--seg-bg);
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 22rpx;
}

.seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-3);
  border-radius: 15rpx;
  transition: all 0.2s;
}

.seg-item.active {
  background: var(--card);
  color: var(--primary);
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.14);
}

/* ---------------- 主卡片（门锁状态） ---------------- */

.hero {
  position: relative;
  border-radius: 32rpx;
  padding: 40rpx 34rpx 34rpx;
  background: var(--hero);
  box-shadow: var(--shadow-lg);
  margin-bottom: 22rpx;
  overflow: hidden;
}

.hero::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: -120rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--hero-glass);
  color: var(--hero-text);
  font-size: 23rpx;
}

.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9aa7c2;
}

.hero-dot.on { background: #4ade80; box-shadow: 0 0 0 6rpx rgba(74, 222, 128, 0.22); }
.hero-dot.warn { background: #fbbf24; }

.hero-ring {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: var(--hero-glass);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--hero-text);
  margin: 0 auto 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.hero-ring.open {
  color: #b9f7cf;
  border-color: rgba(185, 247, 207, 0.5);
  box-shadow: 0 0 0 10rpx rgba(185, 247, 207, 0.08);
}

.hero-state {
  text-align: center;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--hero-text);
  letter-spacing: 2rpx;
}

.hero-state .sub {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--hero-sub);
  letter-spacing: 0;
  margin-top: 10rpx;
}

/* ---------------- 按钮 ---------------- */

.btn {
  border-radius: 20rpx;
  font-size: 30rpx;
  padding: 26rpx 0;
  margin: 0;
  line-height: 1.3;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--card);
  color: var(--text);
}

.btn::after { border: none; }

.btn.primary {
  background: var(--primary);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.28);
}

.theme-dark .btn.primary {
  color: #08101f;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.45);
}

.btn.ghost {
  background: transparent;
  color: var(--primary);
  border: 1rpx solid var(--primary);
}

.btn.plain {
  background: var(--card);
  color: var(--text-2);
  border: 1rpx solid var(--line);
}

.btn.danger {
  background: var(--danger-soft);
  color: var(--danger);
  border: 1rpx solid transparent;
}

.btn.big {
  padding: 34rpx 0;
  font-size: 34rpx;
  border-radius: 24rpx;
}

.btn.sm {
  padding: 18rpx 0;
  font-size: 26rpx;
  border-radius: 16rpx;
}

.btn[disabled] { opacity: 0.45; }

.btn-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.btn-row .btn { flex: 1; }
.btn-row:last-child { margin-bottom: 0; }

/* ---------------- 统计格 ---------------- */

.stats {
  display: flex;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.stat {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  padding: 26rpx 24rpx;
  box-shadow: var(--shadow);
}

.stat-label {
  font-size: 23rpx;
  color: var(--text-3);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.25;
  margin-top: 8rpx;
}

.stat-unit {
  font-size: 24rpx;
  color: var(--text-3);
  font-weight: 400;
  margin-left: 6rpx;
}

/* ---------------- 表单 ---------------- */

.field {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.field:last-child { border-bottom: none; }

.field-label {
  width: 200rpx;
  flex: none;
  font-size: 27rpx;
  color: var(--text-2);
}

.field-input {
  flex: 1;
  min-height: 44rpx;
  font-size: 27rpx;
  color: var(--text);
  text-align: right;
}

/* input 的 placeholder-class（写在 wxml 的 placeholder-class="ph"） */
.ph {
  color: var(--text-3);
  font-size: 27rpx;
}

.hint {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin-top: 10rpx;
}

.hint.box {
  display: flex;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: var(--card-2);
  border: 1rpx solid var(--line);
  margin-top: 16rpx;
}

.hint.box.warn {
  background: var(--warn-soft);
  border-color: transparent;
  color: var(--warn);
}

.hint.box.warn .hint-text { color: var(--warn); }

.hint-text { flex: 1; font-size: 22rpx; line-height: 1.6; color: var(--text-3); }

.hint .strong { color: var(--text); }

/* ---------------- 日志 ---------------- */

.log-box {
  background: var(--card-2);
  border: 1rpx solid var(--line-2);
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  max-height: 460rpx;
  overflow-y: auto;
}

.log-line {
  display: flex;
  gap: 12rpx;
  font-size: 23rpx;
  color: var(--text-2);
  font-family: Consolas, Menlo, monospace;
  word-break: break-all;
  padding: 7rpx 0;
  border-bottom: 1rpx dashed var(--line-2);
}

.log-line:last-child { border-bottom: none; }

.log-time { color: var(--text-3); flex: none; }
.log-line.err { color: var(--danger); }
.log-line.rx { color: var(--ok); }

/* ---------------- 设备列表 ---------------- */

.dev-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.dev-item:last-child { border-bottom: none; }

.dev-name { font-size: 28rpx; color: var(--text); }
.dev-meta { font-size: 22rpx; color: var(--text-3); margin-top: 6rpx; word-break: break-all; }

.dev-connect {
  font-size: 25rpx;
  color: var(--primary);
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--primary);
  border-radius: 999rpx;
  flex: none;
  margin-left: 16rpx;
}

.empty {
  text-align: center;
  color: var(--text-3);
  font-size: 25rpx;
  padding: 34rpx 0;
}

.group-head {
  font-size: 25rpx;
  color: var(--text-3);
  font-weight: 600;
  padding: 10rpx 6rpx 14rpx;
  letter-spacing: 1rpx;
}

.section-gap { height: 10rpx; }

/* ---------------- 主题选择 ---------------- */

.theme-row {
  display: flex;
  gap: 18rpx;
}

.theme-tile {
  flex: 1;
  border-radius: 22rpx;
  border: 2rpx solid var(--line);
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: var(--text-2);
  background: var(--card-2);
}

.theme-tile.on {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary);
}

.theme-tile .t {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}

.theme-tile.on .t { color: var(--primary); }

/* ---------------- 徽标 ---------------- */

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--card-2);
  color: var(--text-3);
  border: 1rpx solid var(--line);
}

.tag.ok { background: var(--ok-soft); color: var(--ok); border-color: transparent; }
.tag.warn { background: var(--warn-soft); color: var(--warn); border-color: transparent; }
.tag.danger { background: var(--danger-soft); color: var(--danger); border-color: transparent; }
